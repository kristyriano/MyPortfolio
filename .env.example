# Copy this file, rename the copy to ".env" and fill in your own values.
# Never upload the real .env file to GitHub.

# MongoDB Atlas connection string. Note the database name "Portfolio" before the "?"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Portfolio?retryWrites=true&w=majority

# Secret key used to sign the JWT tokens (any long random text)
JWT_SECRET=write_any_long_random_text_here

# Backend port
PORT=3000
